<!DOCTYPE html><html class="dark" lang="ru" style=""><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta content="web_dashboard" name="shell-type">
<title>МосТрам Аналитика</title>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&amp;family=Russo+One:wght@400;500;700&amp;family=PT+Sans:wght@400;500;700&amp;family=Space+Grotesk:wght@500;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link rel="stylesheet" href="/static/css/style.css">
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "outline-variant": "#424753",
          "on-primary-container": "#00306e",
          "outline": "#8c909e",
          "background": "#111318",
          "surface": "#111318",
          "on-primary-fixed-variant": "#004494",
          "secondary-fixed": "#d8e2ff",
          "surface-container-high": "#282a2f",
          "on-tertiary-container": "#313333",
          "on-tertiary-fixed-variant": "#454747",
          "primary-container": "#6299ff",
          "on-error-container": "#ffdad6",
          "inverse-on-surface": "#2e3036",
          "on-secondary-fixed": "#001a42",
          "tertiary": "#c6c6c7",
          "on-background": "#e2e2e9",
          "tertiary-fixed": "#e2e2e2",
          "inverse-surface": "#e2e2e9",
          "on-tertiary": "#2f3131",
          "primary": "#adc6ff",
          "surface-container-low": "#1a1b21",
          "on-tertiary-fixed": "#1a1c1c",
          "on-surface": "#e2e2e9",
          "surface-bright": "#37393f",
          "primary-fixed-dim": "#adc6ff",
          "on-secondary-container": "#e6ecff",
          "surface-container-highest": "#33353a",
          "on-primary-fixed": "#001a41",
          "secondary-container": "#0566d9",
          "error-container": "#93000a",
          "error": "#ffb4ab",
          "surface-tint": "#adc6ff",
          "surface-container": "#1e1f25",
          "inverse-primary": "#105bbd",
          "secondary": "#adc6ff",
          "on-primary": "#002e69",
          "surface-variant": "#33353a",
          "tertiary-container": "#9a9b9b",
          "surface-container-lowest": "#0c0e13",
          "on-surface-variant": "#c2c6d5",
          "secondary-fixed-dim": "#adc6ff",
          "on-secondary": "#002e6a",
          "tertiary-fixed-dim": "#c6c6c7",
          "primary-fixed": "#d8e2ff",
          "on-secondary-fixed-variant": "#004395",
          "on-error": "#690005",
          "surface-dim": "#111318"
        },
        borderRadius: {
          DEFAULT: "0.25rem",
          lg: "0.5rem",
          xl: "0.75rem",
          full: "9999px"
        },
        spacing: {
          "space-xs": "0.25rem",
          "margin-mobile": "0.75rem",
          "space-lg": "1.25rem",
          "gutter-sm": "0.75rem",
          "margin": "1.25rem",
          "space-md": "0.875rem",
          "space-xl": "2rem",
          "space-sm": "0.5rem",
          "gutter": "1rem"
        },
        fontFamily: {
          "headline-sm": ["Moscow Sans ExtraBold", "sans-serif"],
          "display-lg": ["Moscow Sans", "sans-serif"],
          "headline-md": ["Moscow Sans", "sans-serif"],
          "label-mono": ["Moscow Sans", "monospace"],
          "metric-md": ["Moscow Sans", "sans-serif"],
          "label-ui": ["Moscow Sans", "sans-serif"],
          "metric-xl": ["Moscow Sans ExtraBold", "sans-serif"],
          "body-md": ["Moscow Sans", "sans-serif"],
          "display-lg-mobile": ["Moscow Sans", "sans-serif"],
          "body-lg": ["Russo One", "sans-serif"],
          "space": ["Moscow Sans", "sans-serif"],
          "inter": ["Moscow Sans", "sans-serif"]
        }
      }
    }
  };
</script>
<style>
  @layer base {
    html, body { margin: 0; padding: 0; }
    body { overscroll-behavior: none; }
    main > :first-child { margin-top: 0 !important; }
    main > :last-child { margin-bottom: 0 !important; }
  }
  ::-webkit-scrollbar { display: none; }

  /* Keyframe Animations */
  @keyframes entranceFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes entranceSlideRight {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes scanlineSweep {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    85% {
      opacity: 0.7;
    }
    100% {
      transform: translateY(600px);
      opacity: 0;
    }
  }

  @keyframes readyGlowPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(78, 222, 163, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(78, 222, 163, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(78, 222, 163, 0);
    }
  }

  @keyframes barGrow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes shimmerFlow {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  @keyframes tramTrackPulse {
    0%, 100% { stroke-opacity: 0.35; stroke-width: 9; }
    50% { stroke-opacity: 0.85; stroke-width: 12; }
  }

  @keyframes pulseGlowRed {
    0%, 100% {
      box-shadow: 0 0 10px rgba(255, 180, 171, 0.2), inset 0 0 8px rgba(147, 0, 10, 0.4);
      border-color: rgba(255, 180, 171, 0.4);
    }
    50% {
      box-shadow: 0 0 20px rgba(255, 180, 171, 0.6), inset 0 0 14px rgba(147, 0, 10, 0.7);
      border-color: rgba(255, 180, 171, 0.9);
    }
  }

  @keyframes beaconPing {
    0% { transform: scale(0.9); opacity: 0.9; }
    75%, 100% { transform: scale(2.4); opacity: 0; }
  }

  @keyframes liveDotGlow {
    0%, 100% { box-shadow: 0 0 4px #4edea3; transform: scale(1); }
    50% { box-shadow: 0 0 12px #4edea3; transform: scale(1.15); }
  }

  @keyframes numFlash {
    0% { filter: brightness(1); }
    50% { filter: brightness(1.35) drop-shadow(0 0 6px rgba(98, 153, 255, 0.8)); }
    100% { filter: brightness(1); }
  }

  /* Staggered Entrance Animations */
  .anim-entrance-sidebar {
    animation: entranceSlideRight 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }
  .anim-entrance-kpi-1 {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .anim-entrance-kpi-2 {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.20s both;
  }
  .anim-entrance-hud {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .anim-entrance-route-header {
    animation: entranceFadeUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .anim-entrance-route-search {
    animation: entranceFadeUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.30s both;
  }
  .anim-entrance-card-1 {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }
  .anim-entrance-card-2 {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.42s both;
  }
  .anim-entrance-card-3 {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.49s both;
  }
  .anim-entrance-card-4 {
    animation: entranceFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.56s both;
  }
  .anim-entrance-map {
    animation: entranceFadeUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.30s both;
  }
  .anim-entrance-chart {
    animation: entranceFadeUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
  }

  /* Terminal Boot Scanline FX */
  .terminal-scanline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent 0%, rgba(98, 153, 255, 0.2) 20%, rgba(173, 198, 255, 0.95) 50%, rgba(98, 153, 255, 0.2) 80%, transparent 100%);
    box-shadow: 0 0 16px 3px rgba(98, 153, 255, 0.75);
    pointer-events: none;
    z-index: 25;
    animation: scanlineSweep 2.2s cubic-bezier(0.4, 0, 0.2, 1) 0.4s 1 forwards;
  }

  .ready-pulse-dot {
    animation: readyGlowPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .bar-grow-origin {
    transform-origin: bottom;
    animation: barGrow 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }

  .bar-shimmer {
    background: linear-gradient(90deg, #6299ff 0%, #adc6ff 40%, #ffffff 50%, #adc6ff 60%, #6299ff 100%);
    background-size: 250% 100%;
    animation: shimmerFlow 5s linear infinite;
  }

  .tram-path-glow {
    animation: tramTrackPulse 3s ease-in-out infinite;
  }

  .alert-critical-pulse {
    animation: pulseGlowRed 2s ease-in-out infinite;
  }

  .beacon-effect::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    background: rgba(98, 153, 255, 0.7);
    animation: beaconPing 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .live-pulse-dot {
    animation: liveDotGlow 1.8s ease-in-out infinite;
  }

  .num-flicker {
    animation: numFlash 0.5s ease-out;
  }

  /* Dynamic Tram Motion along Path */
  .tram-marker-motion {
    offset-path: path("M 645 50 C 645 80 635 110 635 130 C 635 160 642 180 640 195 L 605 240 L 615 285 L 630 330 L 625 385 L 535 385 L 470 450 L 410 520 L 380 560");
    offset-rotate: auto 90deg;
    animation: tramDrive 18s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  @keyframes tramDrive {
    0% { offset-distance: 0%; }
    100% { offset-distance: 100%; }
  }

  /* Active card styling helper */
  .route-card-active {
    background: linear-gradient(rgb(11, 19, 34) 0%, rgb(30, 53, 91) 60%, rgb(48, 88, 153) 100%) !important;
    border: 2px solid rgb(98, 153, 255) !important;
    box-shadow: rgba(98, 153, 255, 0.35) 0px 0px 25px inset, rgba(98, 153, 255, 0.25) 0px 0px 20px !important;
  }

  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      animation-delay: 0ms !important;
      transition-duration: 0.01ms !important;
      filter: none !important;
    }
    .tram-marker-motion, .terminal-scanline {
      animation: none !important;
      display: none !important;
    }
  }
</style>
</head>
<body class="bg-background font-body-md text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container min-h-screen">
<svg aria-hidden="true" class="inline-defs-container" style="position:absolute;width:0;height:0;overflow:hidden"></svg>
<!-- Interactive Navigation Sidebar with Staggered Entrance Slide -->
<aside class="anim-entrance-sidebar fixed left-0 top-0 h-full w-72 bg-surface-container-lowest z-50 flex flex-col justify-between shadow-[0_1px_8px_rgba(0,0,0,0.04)] border-r border-white/[0.04]">
<div class="flex flex-col">
<!-- Brand Header -->
<div class="h-16 px-margin flex items-center gap-space-sm bg-surface-container-lowest">
<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-surface-container-high text-primary ring-1 ring-primary/20 shadow-[0_0_12px_rgba(98,153,255,0.2)]">
<span class="material-symbols-outlined text-[20px]">tram</span>
</div>
<div class="flex flex-col min-w-0">
<span class="font-headline-sm text-headline-sm text-on-surface tracking-tight truncate">МосТрам Аналитика</span>
</div>
</div>
<!-- Section Label with Telemetry Ready Indicator -->
<div class="px-space-md py-space-sm flex items-center justify-between">
<div class="px-space-sm py-space-xs font-label-mono text-label-mono text-outline uppercase tracking-wider flex items-center gap-2">
<span class="">Операционная панель</span>

</div>
<span class="w-2 h-2 rounded-full bg-emerald-400 live-pulse-dot ready-pulse-dot mr-2" title="Система телеметрии онлайн"></span>
</div>
<!-- Nav Items with interactive glowing hover states -->
<nav class="flex flex-col gap-space-xs px-space-md" id="sidebar-nav">
<!-- Active Item: Dashboard -->
<a aria-current="page" class="nav-item group flex items-center gap-space-md px-space-md py-space-sm rounded-lg text-white font-bold transition-all duration-300 relative overflow-hidden" data-path="dashboard" href="#" style="background: linear-gradient(to right, rgba(98, 153, 255, 0.45) 0%, rgba(12, 14, 19, 0.95) 100%); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: rgba(98, 153, 255, 0.22) 0px 0px 20px -4px;">
<span class="indicator-bar absolute left-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-white rounded-r shadow-[0_0_8px_rgba(255,255,255,0.7)] transition-transform duration-200"></span>
<svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110 stroke-white fill-none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
<rect height="7" rx="1" width="7" x="3" y="3"></rect>
<rect height="7" rx="1" width="7" x="14" y="3"></rect>
<rect height="7" rx="1" width="7" x="14" y="14"></rect>
<rect height="7" rx="1" width="7" x="3" y="14"></rect>
</svg>
<span class="font-body-md text-body-md text-white transition-colors duration-200">Дашборд</span>
</a>
<!-- Inactive Item: Map -->
<a class="nav-item group flex items-center gap-space-md px-space-md py-space-sm rounded-lg text-on-surface-variant transition-all duration-300 relative cursor-pointer hover:text-white" data-path="karta" href="#" onmouseenter="this.style.background='linear-gradient(to right, rgba(98, 153, 255, 0.25) 0%, rgba(12, 14, 19, 0.85) 100%)'; this.style.borderColor='rgba(98, 153, 255, 0.3)'; this.style.transform='translateX(3px)';" onmouseleave="this.style.background=''; this.style.borderColor='rgba(255, 255, 255, 0.04)'; this.style.transform='translateX(0)';" style="border: 1px solid rgba(255, 255, 255, 0.04);">
<svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110 stroke-on-surface-variant group-hover:stroke-white fill-none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
<line x1="8" x2="8" y1="2" y2="18"></line>
<line x1="16" x2="16" y1="6" y2="22"></line>
</svg>
<span class="font-body-md text-body-md">Карта</span>
</a>
<!-- Inactive Item: Routes -->
<a class="nav-item group flex items-center gap-space-md px-space-md py-space-sm rounded-lg text-on-surface-variant transition-all duration-300 relative cursor-pointer hover:text-white" data-path="marshruty" href="#" onmouseenter="this.style.background='linear-gradient(to right, rgba(98, 153, 255, 0.25) 0%, rgba(12, 14, 19, 0.85) 100%)'; this.style.borderColor='rgba(98, 153, 255, 0.3)'; this.style.transform='translateX(3px)';" onmouseleave="this.style.background=''; this.style.borderColor='rgba(255, 255, 255, 0.04)'; this.style.transform='translateX(0)';" style="border: 1px solid rgba(255, 255, 255, 0.04);">
<svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110 stroke-on-surface-variant group-hover:stroke-white fill-none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
<circle cx="6" cy="19" r="3"></circle>
<path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path>
<circle cx="18" cy="5" r="3"></circle>
</svg>
<span class="font-body-md text-body-md">Маршруты</span>
</a>
<!-- Inactive Item: Settings -->
<a class="nav-item group flex items-center gap-space-md px-space-md py-space-sm rounded-lg text-on-surface-variant transition-all duration-300 relative cursor-pointer hover:text-white" data-path="nastrojki" href="#" onmouseenter="this.style.background='linear-gradient(to right, rgba(98, 153, 255, 0.25) 0%, rgba(12, 14, 19, 0.85) 100%)'; this.style.borderColor='rgba(98, 153, 255, 0.3)'; this.style.transform='translateX(3px)';" onmouseleave="this.style.background=''; this.style.borderColor='rgba(255, 255, 255, 0.04)'; this.style.transform='translateX(0)';" style="border: 1px solid rgba(255, 255, 255, 0.04);">
<svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110 stroke-on-surface-variant group-hover:stroke-white fill-none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
<line x1="4" x2="20" y1="21" y2="21"></line>
<line x1="4" x2="20" y1="14" y2="14"></line>
<line x1="4" x2="20" y1="7" y2="7"></line>
<circle cx="8" cy="7" r="2"></circle>
<circle cx="16" cy="14" r="2"></circle>
<circle cx="10" cy="21" r="2"></circle>
</svg>
<span class="font-body-md text-body-md">Настройки</span>
</a>
</nav>
</div>
<!-- Bottom Interactive Action Button with Click Feedback -->
<div class="p-space-md bg-surface-container-lowest border-t border-white/[0.04]">
<button class="w-full py-space-sm px-space-md rounded-lg bg-surface-container-low hover:bg-surface-container hover:text-white text-on-surface-variant font-body-md text-body-md flex items-center justify-center gap-space-sm transition-all duration-200 active:scale-95 shadow-sm hover:shadow-[0_0_15px_rgba(98,153,255,0.2)] border border-white/[0.06] hover:border-primary/40 relative overflow-hidden group" id="export-report-btn">
<span class="material-symbols-outlined text-[20px] text-primary transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:text-primary-container">download</span>
<span class="transition-colors" id="export-btn-text">Экспорт суточного отчета</span>
</button>
</div>
</aside>
<!-- Main Workspace Content Container -->
<div class="pl-72">
<main class="w-full min-h-screen bg-background px-margin pb-10">
<div class="flex flex-col w-full">
<div class="py-space-md flex flex-col gap-gutter">
<!-- Top Utility Bar: Live ticking clock & telemetry tickers (Staggered Entrance Delays 0.15s - 0.25s) -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-gutter">
<!-- Card 1: Passenger Flow -->
<div class="anim-entrance-kpi-1 p-space-md rounded-xl bg-surface-container-lowest flex items-center justify-between shadow-sm border border-white/[0.05] hover:border-primary/30 transition-all duration-300 group">
<div class="flex flex-col">
<span class="font-label-mono text-label-mono text-outline uppercase tracking-wider flex items-center gap-1.5">
                Пассажиропоток за сутки
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 live-pulse-dot"></span>
</span>
<span class="font-metric-xl text-metric-xl text-on-surface tracking-tight transition-all duration-300" id="metric-passengers">142&nbsp;815</span>
</div>
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary group-hover:scale-105 group-hover:bg-primary/20 transition-all duration-300">
<span class="material-symbols-outlined text-[24px]">groups</span>
</div>
</div>
<!-- Card 2: Next Hour Forecast -->
<div class="anim-entrance-kpi-2 p-space-md rounded-xl bg-surface-container-lowest flex items-center justify-between shadow-sm border border-white/[0.05] hover:border-primary/30 transition-all duration-300 group">
<div class="flex flex-col">
<span class="font-label-mono text-label-mono text-outline uppercase tracking-wider">Прогноз на след. час</span>
<span class="font-metric-xl text-metric-xl text-primary flex items-baseline gap-1.5">
<span class="transition-all duration-300" id="metric-forecast-pct">+14.8%</span>
<span class="font-label-mono text-label-mono text-secondary font-normal">+21.4 тыс/ч</span>
</span>
</div>
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-primary group-hover:scale-105 group-hover:bg-primary/20 transition-all duration-300">
<span class="material-symbols-outlined text-[24px]">trending_up</span>
</div>
</div>
<!-- Card 3 & 4: Live Clock & Date HUD -->
<div class="anim-entrance-hud md:col-span-2 rounded-xl bg-surface-container-lowest flex items-center justify-center shadow-sm" style="border: 1px solid rgba(255, 255, 255, 0.08); padding: 5px;">
<div class="w-full flex items-center justify-between px-space-md py-space-sm rounded-lg bg-surface-container-low/80 border border-white/[0.08]">
<!-- Live Ticking Clock -->
<div class="flex items-center gap-space-xs text-on-surface">
<svg class="w-5 h-5 text-primary animate-pulse" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
<circle cx="12" cy="12" r="10"></circle>
<polyline points="12 6 12 12 14 14"></polyline>
</svg>
<span class="font-headline-sm text-headline-sm text-on-surface tracking-tight font-bold font-mono" id="live-time-display">04:02:08</span>

</div>
<div class="h-5 w-px bg-outline-variant/60"></div>
<!-- Calendar Date -->
<div class="flex items-center gap-space-xs text-on-surface cursor-pointer group hover:text-primary transition-colors">
<svg class="w-5 h-5 text-outline group-hover:text-primary transition-colors" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24">
<rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
<line x1="16" x2="16" y1="2" y2="6"></line>
<line x1="8" x2="8" y1="2" y2="6"></line>
<line x1="3" x2="21" y1="10" y2="10"></line>
</svg>
<span class="font-headline-sm text-headline-sm text-on-surface tracking-tight group-hover:text-primary transition-colors font-semibold">December 24</span>
