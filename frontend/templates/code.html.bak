<!-- Dynamic Real-time Traveling Tram Marker along the route path vector -->
<g class="tram-marker-motion">
<circle cx="0" cy="0" fill="#6299FF" opacity="0.4" r="12">
<animate attributeName="r" dur="1.5s" repeatCount="indefinite" values="6;16;6"></animate>
<animate attributeName="opacity" dur="1.5s" repeatCount="indefinite" values="0.6;0;0.6"></animate>
</circle>
<rect fill="#6299FF" height="14" rx="3" stroke="#FFFFFF" stroke-width="2" width="22" x="-11" y="-7"></rect>
<text fill="#001A41" font-family="'PT Sans', monospace" font-size="8" font-weight="700" text-anchor="middle" y="3.5">#412</text>
</g>
<!-- Additional Tram #418 & #409 Static/telemetric positions -->
<g transform="translate(435, 488)">
<rect fill="#6299FF" height="12" rx="3" stroke="#FFFFFF" stroke-width="1.5" width="20" x="-10" y="-6"></rect>
