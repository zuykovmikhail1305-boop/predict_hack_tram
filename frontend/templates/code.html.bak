</path>
<!-- Route Tramway Stops (Nodes) with Labels -->
<!-- Stop 1: Чистые пруды -->
<circle cx="645" cy="50" fill="#0C0E13" r="5.5" stroke="#6299FF" stroke-width="2.5"></circle>
