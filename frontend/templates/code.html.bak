<!-- Outer Glow Bloom with CSS Animation -->
<path class="tram-path-glow" d="M 645 50 C 645 80 635 110 635 130 C 635 160 642 180 640 195 L 605 240 L 615 285 L 630 330 L 625 385 L 535 385 L 470 450 L 410 520 L 380 560" stroke="#6299FF" stroke-linecap="round" stroke-linejoin="round"></path>
