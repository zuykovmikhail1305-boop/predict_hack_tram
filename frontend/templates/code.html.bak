<path d="M 50 420 Q 320 380 620 180 T 960 90" stroke="#202430" stroke-width="3"></path>
<path d="M 400 650 Q 560 480 580 250 T 640 0" stroke="#202430" stroke-width="4"></path>
<path d="M 180 250 Q 420 280 820 240" stroke="#202430" stroke-width="2"></path>
<!-- Inactive Transit Routes (Ghost lines) -->
<path d="M 320 580 L 450 420 L 520 360 L 610 360 L 710 240 L 800 180" stroke="#282E3E" stroke-dasharray="2 3" stroke-width="2.5"></path>
<path d="M 210 310 L 360 310 L 480 390 L 560 520" stroke="#282E3E" stroke-dasharray="2 3" stroke-width="2.5"></path>
<!-- District Labels -->
<text fill="#424753" font-family="'PT Sans', monospace" font-size="10" letter-spacing="1" x="590" y="90">КРАСНОСЕЛЬСКИЙ Р-Н</text>
