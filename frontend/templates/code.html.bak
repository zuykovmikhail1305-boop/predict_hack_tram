</div>
<!-- Stop 2: Павелецкий вокзал (ACTIVE STOP WITH BEACON) -->
<div class="stop-item relative flex items-start gap-space-sm p-space-xs rounded bg-surface-container-high/70 border border-primary/40 shadow-[0_0_15px_rgba(98,153,255,0.15)] cursor-pointer transition-all duration-200 group">
<div class="relative z-10 w-6 flex justify-center">
<div class="relative beacon-effect">
<div class="w-3 h-3 rounded-full bg-primary ring-4 ring-primary-container/30 shadow-[0_0_12px_rgba(98,153,255,0.9)] mt-0.5"></div>
</div>
</div>
<div class="flex-1 flex flex-col min-w-0">
<div class="flex items-baseline justify-between gap-1">
<span class="font-headline-sm text-[12px] text-primary font-bold truncate">ст. Павелецкий вокзал</span>
<span class="px-space-xs py-0.5 rounded bg-primary-container/20 text-primary font-label-mono text-[10px] font-bold border border-primary/30">Посадка</span>
</div>
<div class="flex items-center justify-between mt-0.5">
<span class="font-label-mono text-[10px] text-on-surface-variant">+84 / -92 пасс.</span>
<span class="font-label-mono text-[10px] text-primary font-bold flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                          Сейчас
                        </span>
</div>
</div>
</div>
<!-- Stop 3: Даниловский рынок -->
<div class="stop-item relative flex items-start gap-space-sm p-1 rounded-lg hover:bg-surface-container-high/60 cursor-pointer transition-all duration-200 group">
<div class="relative z-10 w-6 flex justify-center">
<div class="w-2 h-2 rounded-full bg-surface-container-highest border border-outline-variant mt-1 group-hover:bg-primary group-hover:border-primary transition-colors"></div>
</div>
<div class="flex-1 flex items-baseline justify-between min-w-0">
<div class="flex flex-col min-w-0">
<span class="font-headline-sm text-[12px] text-on-surface-variant font-medium truncate group-hover:text-white transition-colors">ст. Даниловский рынок</span>
<span class="font-label-mono text-[10px] text-outline">Следующая остановка</span>
</div>
<span class="font-label-mono text-[10px] text-secondary font-medium shrink-0">~4 мин</span>
</div>
</div>
<!-- Stop 4: Тульская -->
<div class="stop-item relative flex items-start gap-space-sm p-1 rounded-lg hover:bg-error-container/20 cursor-pointer transition-all duration-200 group">
<div class="relative z-10 w-6 flex justify-center">
<div class="w-2 h-2 rounded-full bg-error border border-error-container mt-1 shadow-[0_0_6px_rgba(255,180,171,0.5)]"></div>
</div>
<div class="flex-1 flex items-baseline justify-between min-w-0">
<div class="flex flex-col min-w-0">
<span class="font-headline-sm text-[12px] text-error font-medium truncate">ст. Метро Тульская</span>
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-error text-[10px]">warning</span>
<span class="font-label-mono text-[10px] text-error">Задержка +1.5 мин</span>
</div>
</div>
<span class="font-label-mono text-[10px] text-outline shrink-0">~11 мин</span>
</div>
</div>
<!-- Stop 5: Академическая -->
<div class="stop-item relative flex items-start gap-space-sm p-1 rounded-lg hover:bg-surface-container-high/60 cursor-pointer transition-all duration-200 group">
<div class="relative z-10 w-6 flex justify-center">
<div class="w-2 h-2 rounded-full bg-surface-container-highest border border-outline mt-1 group-hover:bg-primary transition-colors"></div>
</div>
<div class="flex-1 flex items-baseline justify-between min-w-0">
<div class="flex flex-col min-w-0">
<span class="font-headline-sm text-[12px] text-on-surface-variant font-medium truncate group-hover:text-white transition-colors">ст. Академическая</span>
<span class="font-label-mono text-[10px] text-outline">Конечная станция</span>
</div>
<span class="font-label-mono text-[10px] text-outline shrink-0">~18 мин</span>
</div>
</div>
</div>
</div>
<!-- Bottom-Left Watermark -->
<div class="absolute bottom-space-sm left-space-md z-10 flex items-center gap-space-xs opacity-60 pointer-events-none">
<span class="font-headline-sm text-headline-sm text-outline tracking-wider font-bold">ГУП Московский метрополитен</span>
</div>
</div>
<!-- Lower Section: Bar Charts with Interactive Tooltips & Staggered Entrance (Delay 0.45s) -->
<div class="grid grid-cols-1 gap-gutter w-full">
<div class="anim-entrance-chart bg-surface-container-lowest p-space-lg rounded-xl flex flex-col justify-between shadow-md min-h-[220px] w-full border border-white/[0.05]">
<div class="flex items-center justify-between mb-space-sm">
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-on-surface">Почасовая динамика пассажиропотока</span>
<span class="font-label-mono text-label-mono text-outline">Нагрузка по ключевым операционным окнам</span>
</div>
<div class="flex items-center gap-space-xs">
<span class="px-space-sm py-0.5 rounded bg-surface-container font-label-mono text-label-mono text-primary border border-primary/20" id="chart-route-tag">Маршрут Т1</span>
</div>
</div>
<!-- 3 Telemetry Bars with Interactive Hover Tooltips and Entrance Shimmer -->
<div class="grid grid-cols-3 gap-gutter items-end h-32 pt-2 px-space-md relative">
<!-- Dynamic Tooltip Element -->
<div class="absolute pointer-events-none opacity-0 transition-opacity duration-200 bg-surface-container-highest/95 border border-primary/40 px-3 py-1.5 rounded-lg shadow-xl text-center z-30 transform -translate-x-1/2 -translate-y-full mb-2" id="bar-tooltip">
<div class="font-label-mono text-[10px] text-outline" id="tooltip-title"></div>
<div class="font-headline-sm text-[13px] text-primary font-bold" id="tooltip-value"></div>
</div>
<!-- Column 1: Morning Peak -->
<div class="bar-col flex flex-col items-center h-full justify-end group cursor-pointer" data-passengers="28 400 чел." data-percent="85%" data-period="07:00 — 10:00 (Утренний пик)">
<div class="bar-grow-origin bar-shimmer w-full rounded-t-md group-hover:brightness-110 group-hover:shadow-[0_0_24px_rgba(98,153,255,0.7)] transition-all duration-300 flex items-center justify-center text-on-primary-container font-label-mono text-label-mono font-bold" style="height: 85%;">
                      28.4 тыс
                    </div>
</div>
<!-- Column 2: Midday Base / Evening Peak -->
<div class="bar-col flex flex-col items-center h-full justify-end group cursor-pointer" data-passengers="32 100 чел." data-percent="100%" data-period="17:30 — 20:30 (Вечерний максимум)">
<div class="bar-grow-origin bar-shimmer w-full rounded-t-md group-hover:brightness-110 group-hover:shadow-[0_0_24px_rgba(98,153,255,0.7)] transition-all duration-300 flex items-center justify-center text-on-primary-container font-label-mono text-label-mono font-bold" style="height: 100%;">
                      32.1 тыс
                    </div>
</div>
<!-- Column 3: Evening Peak / Interval -->
<div class="bar-col flex flex-col items-center h-full justify-end group cursor-pointer" data-passengers="29 800 чел." data-percent="90%" data-period="12:00 — 15:00 (Межпиковый интервал)">
<div class="bar-grow-origin bar-shimmer w-full rounded-t-md group-hover:brightness-110 group-hover:shadow-[0_0_24px_rgba(98,153,255,0.7)] transition-all duration-300 flex items-center justify-center text-on-primary-container font-label-mono text-label-mono font-bold" style="height: 90%;">
                      29.8 тыс
                    </div>
</div>
</div>
<!-- Labels Bar -->
<div class="grid grid-cols-3 gap-gutter text-center pt-space-sm">
<span class="font-label-mono text-label-mono text-outline truncate hover:text-white transition-colors cursor-default">07:00 — 10:00 Утренний пик</span>
<span class="font-label-mono text-label-mono text-primary font-semibold truncate hover:brightness-125 transition-all cursor-default">17:30 — 20:30 Вечерний максимум</span>
<span class="font-label-mono text-label-mono text-outline truncate hover:text-white transition-colors cursor-default">12:00 — 15:00 Межпиковый интервал</span>
</div>
<div class="text-center pt-space-xs flex items-center justify-center gap-2">
<span class="w-1.5 h-1.5 rounded-full bg-primary/60"></span>
<span class="font-label-mono text-label-mono text-outline tracking-wider uppercase">Подписи к графикам • Сенсоры входных валидаторов</span>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
</main>
</div>
<!-- Interactive Client-side Scripting -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Live Real-time Clock
    const timeDisplay = document.getElementById('live-time-display');
    const ampmDisplay = document.getElementById('live-ampm-display');

    function updateLiveClock() {
      const now = new Date();
      let hours = now.getHours();
      const minutes = String(now.getMinutes()).padStart(2, '0');
      const seconds = String(now.getSeconds()).padStart(2, '0');
      const ampm = hours >= 12 ? 'PM' : 'AM';

      // Keep AM/PM format matching reference UI
      hours = hours % 12;
      hours = hours ? hours : 12;
      const hoursStr = String(hours).padStart(2, '0');

      if (timeDisplay) timeDisplay.textContent = `${hoursStr}:${minutes}:${seconds}`;
      if (ampmDisplay) ampmDisplay.textContent = ampm;
    }
    setInterval(updateLiveClock, 1000);
    updateLiveClock();

    // 2. Interactive Route Selection
    const routeCards = document.querySelectorAll('.route-card');
    const chartTag = document.getElementById('chart-route-tag');

    routeCards.forEach(card => {
      card.addEventListener('click', () => {
        routeCards.forEach(c => {
          c.classList.remove('route-card-active');
          c.style.background = '';
          c.style.borderColor = '';
          c.style.boxShadow = '';
        });

        card.classList.add('route-card-active');
        const routeId = card.getAttribute('data-route-id');
        if (chartTag) {
          chartTag.textContent = `Маршрут ${routeId === 'T1' ? 'Т1' : routeId}`;
          chartTag.classList.add('num-flicker');
          setTimeout(() => chartTag.classList.remove('num-flicker'), 500);
        }
      });
    });

    // 3. Search Filter in Route List
    const searchInput = document.getElementById('route-search-input');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        routeCards.forEach(card => {
          const text = card.textContent.toLowerCase();
          if (text.includes(query)) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    // 4. Bar Chart Tooltip Interaction
    const barCols = document.querySelectorAll('.bar-col');
    const tooltip = document.getElementById('bar-tooltip');
    const tooltipTitle = document.getElementById('tooltip-title');
    const tooltipValue = document.getElementById('tooltip-value');

    barCols.forEach(col => {
      col.addEventListener('mouseenter', (e) => {
        const period = col.getAttribute('data-period');
        const count = col.getAttribute('data-passengers');
        const pct = col.getAttribute('data-percent');

        tooltipTitle.textContent = period;
        tooltipValue.textContent = `${count} (${pct})`;

        const rect = col.getBoundingClientRect();
        const parentRect = col.parentElement.getBoundingClientRect();
        const leftPos = rect.left - parentRect.left + (rect.width / 2);

        tooltip.style.left = `${leftPos}px`;
        tooltip.style.top = `15%`;
        tooltip.style.opacity = '1';
      });

      col.addEventListener('mouseleave', () => {
        tooltip.style.opacity = '0';
      });
    });

    // 5. Live Telemetry Random Data Ticker
    const passengersElem = document.getElementById('metric-passengers');
    const forecastElem = document.getElementById('metric-forecast-pct');

    setInterval(() => {
      if (passengersElem) {
        // Random micro fluctuation +/- 10 passengers
        const currentVal = parseInt(passengersElem.textContent.replace(/\s/g, ''), 10) || 142850;
        const delta = Math.floor(Math.random() * 21) - 10;
        const newVal = currentVal + delta;
        passengersElem.textContent = newVal.toLocaleString('ru-RU');
        passengersElem.classList.add('num-flicker');
        setTimeout(() => passengersElem.classList.remove('num-flicker'), 500);
      }
    }, 4500);

    // 6. Export Button Click Feedback
    const exportBtn = document.getElementById('export-report-btn');
    const exportBtnText = document.getElementById('export-btn-text');

    if (exportBtn && exportBtnText) {
      exportBtn.addEventListener('click', () => {
        const originalText = exportBtnText.textContent;
        exportBtnText.textContent = 'Формирование PDF...';
        exportBtn.classList.add('ring-2', 'ring-primary', 'bg-surface-container-high');

        setTimeout(() => {
          exportBtnText.textContent = 'Отчет готов ✓';
          setTimeout(() => {
            exportBtnText.textContent = originalText;
            exportBtn.classList.remove('ring-2', 'ring-primary', 'bg-surface-container-high');
          }, 2000);
        }, 1200);
      });
    }

    // 7. Stops hover interaction: highlight respective node in SVG
    const stopItems = document.querySelectorAll('.stop-item');
    stopItems.forEach(item => {
      item.addEventListener('mouseenter', () => {
        item.style.transform = 'translateX(4px)';
      });
      item.addEventListener('mouseleave', () => {
        item.style.transform = 'translateX(0)';
      });
    });
  });
</script>


</body></html>