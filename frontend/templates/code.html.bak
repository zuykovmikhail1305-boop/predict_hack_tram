<!-- Terminal Boot Scanline FX -->
<div class="terminal-scanline"></div>
<!-- SVG Dark Basemap & Dynamic Vector Route Animation -->
<svg class="absolute inset-0 w-full h-full object-cover select-none" fill="none" viewBox="0 0 1000 650" xmlns="http://www.w3.org/2000/svg">
<rect fill="#0C0E13" height="650" width="1000"></rect>
<!-- Radial ambient glow around Moscow Center -->
<circle cx="560" cy="200" fill="url(#center-glow)" opacity="0.18" r="320"></circle>
<defs>
<radialGradient cx="50%" cy="50%" id="center-glow" r="50%">
<stop offset="0%" stop-color="#6299ff"></stop>
<stop offset="100%" stop-color="#0c0e13" stop-opacity="0"></stop>
</radialGradient>
<linearGradient id="route-gradient" x1="0%" x2="100%" y1="0%" y2="100%">
<stop offset="0%" stop-color="#6299ff"></stop>
<stop offset="50%" stop-color="#3b82f6"></stop>
<stop offset="100%" stop-color="#adc6ff"></stop>
</linearGradient>
<!-- Filter for intense electric route glow -->
<filter height="140%" id="tramGlow" width="140%" x="-20%" y="-20%">
<feGaussianBlur result="blur" stdDeviation="4"></feGaussianBlur>
<feMerge>
<feMergeNode in="blur"></feMergeNode>
<feMergeNode in="SourceGraphic"></feMergeNode>
</feMerge>
</filter>
</defs>
<!-- Grid & District Lines -->
<path d="M 0 160 L 1000 160 M 0 340 L 1000 340 M 0 500 L 1000 500" stroke="#1A1B21" stroke-dasharray="4 8" stroke-width="1"></path>
<path d="M 250 0 L 250 650 M 550 0 L 550 650 M 800 0 L 800 650" stroke="#1A1B21" stroke-dasharray="4 8" stroke-width="1"></path>
<!-- Moskva River Polyline -->
<path d="M 120 0 C 180 80 280 110 380 100 C 510 80 580 140 600 240 C 620 340 720 380 770 360 C 840 330 890 380 910 500 C 930 600 890 650 880 650" stroke="#161A24" stroke-linecap="round" stroke-linejoin="round" stroke-width="28"></path>
<path d="M 120 0 C 180 80 280 110 380 100 C 510 80 580 140 600 240 C 620 340 720 380 770 360 C 840 330 890 380 910 500 C 930 600 890 650 880 650" stroke="#1B2232" stroke-linecap="round" stroke-linejoin="round" stroke-width="20"></path>
